<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<Configurations>Debug;Release</Configurations>
		<AssemblyName>MapExt2</AssemblyName>
		<RootNamespace>MapExtPDX</RootNamespace>
		<Description>MapSize Extend 28/43/57km</Description>
		<Authors>Noel2</Authors>
		<Copyright>Copyright (c) [2025] [Noel2/Noel-leoN/=Noel=]</Copyright>
		<Title>MapExt: Big Map, Economy and Performance</Title>
		<Version>4.11.0</Version>

		<!--The file where mod information which is required for publishing mod on PDX mods are stored-->
		<PublishConfigurationPath>Properties\PublishConfiguration.xml</PublishConfigurationPath>
		
		<TreatWarningsAsErrors>True</TreatWarningsAsErrors>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <WarningLevel>5</WarningLevel>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <WarningLevel>5</WarningLevel>
	</PropertyGroup>
	
	<!--Imports must be after PropertyGroup block-->
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.props" />
	<Import Project="$([System.Environment]::GetEnvironmentVariable('CSII_TOOLPATH', 'EnvironmentVariableTarget.User'))\Mod.targets" />

	<ItemGroup>
		<Reference Include="Game">			
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Core">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Logging">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.IO.AssetDatabase">
			<Private>false</Private>
		</Reference>
		<!-- 高度圖 PNG 編碼：TextureUtilities.SaveImage / NativeTextures.ImageFileFormat -->
		<Reference Include="Colossal.AssetPipeline.Native">
			<Private>false</Private>
		</Reference>
		<!-- 转换自动存档的同名检查：ILocalAssetDatabase.Exists<PackageAsset>，PackageAsset 实现的接口定义在这里 -->
		<Reference Include="Colossal.AssetPipeline">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.UI.Binding">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Localization">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.Mathematics">
			<Private>false</Private>
		</Reference>
		<Reference Include="Colossal.PSI.Common">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.InputSystem">
			<Private>false</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Burst">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Collections">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Entities">
			<Private>false</Private>
		</Reference>
		<Reference Include="Unity.Mathematics">
			<Private>false</Private>
		</Reference>
	</ItemGroup>

	<ItemGroup>
		<Reference Update="System">
			<Private>False</Private>
		</Reference>
		<Reference Update="System.Core">
			<Private>false</Private>
		</Reference>
		<Reference Update="System.Data">
			<Private>false</Private>
		</Reference>
	</ItemGroup>
	
	<ItemGroup>
		<PackageReference Include="Lib.Harmony" Version="2.2.2" />
	</ItemGroup>
	

	<ItemGroup>
		<None Include="$(ModPropsFile)" Link="Properties\Mod.props" />
		<None Include="$(ModTargetsFile)" Link="Properties\Mod.targets" />
		<None Include="MapExt2.sln" />
	</ItemGroup>

	<!-- Automatically build ModAssemblyInfo.cs file. -->
	<Import Project="ModAssemblyInfo\ModAssemblyInfo.csproj" />
	<ItemGroup>
		<None Include="ModAssemblyInfo\ModAssemblyInfo.csproj" />
	</ItemGroup>

	<!-- Automatically build PublishConfiguration.xml file. -->
	<Import Project="Properties\PublishConfiguration.csproj" />
	<ItemGroup>
		<None Include="Properties\PublishConfiguration.csproj" />
	</ItemGroup>

	

	<!-- UI Frontend: UI/ 目录为纯前端项目，排除所有内容不参与 C# 编译 -->
	<ItemGroup>
		<Compile Remove="MapExt\UI\**" />
		<EmbeddedResource Remove="MapExt\UI\**" />
		<None Remove="MapExt\UI\node_modules\**" />
	</ItemGroup>

	<!-- 模式副本（重构二 D3）：ModeA 是唯一源码；ModeB–E 与各模式的 XCellMapSystemRe_ModeX.cs 由 ModeSources.Generate.ps1
	     在编译前生成，不入版控（见 .gitignore）。XCellMapSystemRe.cs 是生成模板，自身也参与编译（命名空间 ReBurstSystemCore，与生成文件不冲突） -->
	<PropertyGroup>
		<ModeSourcesScript>$(MSBuildProjectDirectory)\MapExt\ReBurstSystem\ModeSources.Generate.ps1</ModeSourcesScript>
		<!-- 生成物的位置：须与生成器的模式表、.gitignore 保持一致 -->
		<_ModeSourceGlobs>
			MapExt\ReBurstSystem\CellSystems\ModeB_28km\**\*.cs;
			MapExt\ReBurstSystem\CellSystems\ModeC_114km\**\*.cs;
			MapExt\ReBurstSystem\CellSystems\ModeD_43km\**\*.cs;
			MapExt\ReBurstSystem\EcoSystems\ModeB_28km\**\*.cs;
			MapExt\ReBurstSystem\EcoSystems\ModeC_114km\**\*.cs;
			MapExt\ReBurstSystem\EcoSystems\ModeD_43km\**\*.cs;
			MapExt\ReBurstSystem\EcoSystems\ModeE_vanilla\**\*.cs;
			MapExt\ReBurstSystem\ReBurstCore\XCellMapSystemRe_Mode?.cs
		</_ModeSourceGlobs>
		<_ModeSourcePattern>^MapExt\\ReBurstSystem\\(CellSystems\\Mode[BCD]_|EcoSystems\\Mode[BCDE]_|ReBurstCore\\XCellMapSystemRe_Mode.\.cs$)</_ModeSourcePattern>
	</PropertyGroup>
	<ItemGroup>
		<!-- 生成器改动时，让 VS 的快速最新检查也触发建置；ModeA 源码与模板本来就是 Compile 项 -->
		<UpToDateCheckInput Include="MapExt\ReBurstSystem\ModeSources.Generate.ps1" />
	</ItemGroup>

	<!-- 编译前生成模式副本。默认 Compile 通配在求值阶段展开，早于任何 target：
	     平时副本已在磁盘上、已被通配收入，编译顺序不变，产物可以逐字节复现；
	     新克隆首次建置时副本还不存在，生成后在此补登，同时移除刚被生成器删除的过期副本。
	     设计时建置不运行，免得在 IDE 中打字时也写文件。 -->
	<Target Name="GenerateModeSources" BeforeTargets="BeforeCompile;CoreCompile" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="pwsh -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;$(ModeSourcesScript)&quot;" />
		<ItemGroup>
			<!-- 只认生成路径，不掩盖其他缺失的源文件 -->
			<_ModeSourceGone Include="@(Compile)" Condition="!Exists('%(Compile.FullPath)') and $([System.Text.RegularExpressions.Regex]::IsMatch('%(Compile.Identity)', '$(_ModeSourcePattern)'))" />
			<Compile Remove="@(_ModeSourceGone)" />
			<_ModeSourceNew Include="$(_ModeSourceGlobs)" Exclude="@(Compile)" />
			<Compile Include="@(_ModeSourceNew)" />
		</ItemGroup>
	</Target>

	<!-- AfterBuild: 自动构建 UI 前端 (npm run build) -->
	<Target Name="BuildUI" AfterTargets="AfterBuild">
		<Message Importance="high" Text="[MapExt] Building UI frontend..." />
		<Exec Command="npm run build" WorkingDirectory="$(ProjectDir)MapExt\UI" />
	</Target>

</Project>

