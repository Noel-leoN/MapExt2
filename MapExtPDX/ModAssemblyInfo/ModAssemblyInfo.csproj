<Project>
    <!-- 以 LF 换行写出生成文件：WriteLinesToFile 会在末尾追加系统换行符（Windows 上为 CRLF），
         与仓库 .gitattributes / .editorconfig 的 eol=lf 不一致，每次建置后 git status 都会误报已修改。
         行为与原 WriteLinesToFile 一致：裁掉首尾空白，内容不变时不写入。 -->
    <UsingTask TaskName="WriteGeneratedFileLF" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
        <ParameterGroup>
            <TargetPath ParameterType="System.String" Required="true" />
            <Content ParameterType="System.String" Required="true" />
        </ParameterGroup>
        <Task>
            <Code Type="Fragment" Language="cs">
                <![CDATA[
                string text = Content.Trim().Replace("\r\n", "\n") + "\n";
                if (!System.IO.File.Exists(TargetPath) || System.IO.File.ReadAllText(TargetPath) != text)
                {
                    System.IO.File.WriteAllText(TargetPath, text, new System.Text.UTF8Encoding(false));
                }
                ]]>
            </Code>
        </Task>
    </UsingTask>

    <!-- Create an C# class file with assembly information. -->
    <Target Name="AddAssemblyInformation" BeforeTargets="BeforeCompile;CoreCompile" Inputs="$(MSBuildAllProjects)" Outputs="$(IntermediateOutputPath)GeneratedFile.xml">
        <PropertyGroup>
            <GeneratedText>
                <![CDATA[
// DO NOT MODIFY THIS FILE.
// This entire file was automatically generated by ModAssemblyInfo.csproj.
// Make any needed changes in ModAssemblyInfo.csproj.

namespace $(AssemblyName)
{
    /// <summary>
    /// Make assembly info available as constant strings.
    /// </summary>
    public class ModAssemblyInfo
    {
        public const string Name        = "$(AssemblyName)"%3B
        public const string Version     = "$(Version)"%3B
        public const string Title       = "$(Title)"%3B
        public const string Description = "$(Description)"%3B
    }
}
                ]]>
            </GeneratedText>
            <GeneratedFilePath>$(ProjectDir)ModAssemblyInfo\ModAssemblyInfo.cs</GeneratedFilePath>
        </PropertyGroup>

        <ItemGroup>
            <FileWrites Include="$(GeneratedFilePath)" />
        </ItemGroup>

        <WriteGeneratedFileLF TargetPath="$(GeneratedFilePath)" Content="$(GeneratedText)" />
    </Target>
</Project>