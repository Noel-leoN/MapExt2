<Project Sdk="Microsoft.NET.Sdk">

  <!-- 单元测试：只测 MapExTools.Core，不依赖 WPF 与命令行接口 -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>MapExTools.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- .coc 固定样本：输入与期望输出逐字节比对（计划 2.1） -->
    <None Include="Coc\Samples\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- 日志诊断的脱敏样本，存成 .txt：*.log 会被 .gitignore 忽略（计划 3.1） -->
    <None Include="Diagnostics\Samples\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MapExTools.Core\MapExTools.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>

</Project>
