<UserControl x:Class="MapExTools.Views.LaunchSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:MapExTools.Services"
             xmlns:views="clr-namespace:MapExTools.Views">
    <UserControl.Resources>
        <!-- 着色样式 ToneText 定义在 App.xaml -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,9,14,9" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <!-- 收紧 Fluent 默认 32px 单选／勾选行高，确保核心选项一屏尽览 -->
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- 启动与设定：首屏常驻快捷启动与 MapExt 11 个核心启动期设定；全部 65 项配置与低频操作一键直达 -->
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10,6,10,4">

            <!-- === 启动游戏：按钮、命令行预览与状态常驻在上；路径、通道与参数收进折叠栏（存进 MapExTools.json） === -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="LaunchButton" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                Style="{DynamicResource AccentButtonStyle}" MinWidth="136" Padding="16,6" Click="OnLaunchClick" />
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{Binding [Launch.Title], Source={x:Static svc:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                                       Text="{Binding [Launch.Intro], Source={x:Static svc:Loc.Instance}}" />
                        </StackPanel>
                    </DockPanel>

                    <TextBox x:Name="CommandPreviewBox" Margin="0,4,0,0" IsReadOnly="True" TextWrapping="Wrap"
                             BorderThickness="0" Background="Transparent" Padding="0" MinHeight="0" FontSize="12"
                             FontFamily="Cascadia Mono, Consolas, Courier New" />

                    <ItemsControl x:Name="LaunchStatusLines" Margin="0,2,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type views:ToneLine}">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Margin="0,1,0,0" Style="{StaticResource ToneText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="RunOncePendingText" TextWrapping="Wrap" FontSize="12" Margin="0,1,0,0" Visibility="Collapsed"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}">
                        <Run x:Name="RunOncePendingRun" />
                        <Hyperlink Click="OnClearRunOnceClick">
                            <Run Text="{Binding [Launch.ClearRunOnce], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                        </Hyperlink>
                    </TextBlock>

                    <Expander x:Name="LaunchOptionsExpander" Margin="0,6,0,0"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                              Expanded="OnLaunchExpanderChanged" Collapsed="OnLaunchExpanderChanged"
                              AutomationProperties.Name="{Binding [Launch.OptionsHeader], Source={x:Static svc:Loc.Instance}}">
                        <Expander.Header>
                            <WrapPanel>
                                <TextBlock FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Text="{Binding [Launch.OptionsHeader], Source={x:Static svc:Loc.Instance}}" />
                                <TextBlock x:Name="LaunchSummaryText" FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding Text}" Style="{StaticResource ToneText}" />
                            </WrapPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,2,0,0">
                            <WrapPanel>
                                <TextBlock x:Name="GameLocationText" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock VerticalAlignment="Center" Margin="0,0,16,0">
                                    <Hyperlink x:Name="ChooseGameLink" Click="OnChooseGameClick">
                                        <Run Text="{Binding [Launch.Choose], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                                <TextBlock x:Name="AutoLocateText" VerticalAlignment="Center">
                                    <Hyperlink Click="OnAutoLocateClick">
                                        <Run Text="{Binding [Launch.AutoLocate], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                                    </Hyperlink>
                                </TextBlock>
                            </WrapPanel>
                            <TextBlock x:Name="GameLocationNote" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                            <TextBlock Style="{StaticResource GroupTitle}" Margin="0,10,0,4"
                                       Text="{Binding [Launch.Group.Channel], Source={x:Static svc:Loc.Instance}}" />
                            <WrapPanel>
                                <RadioButton x:Name="DirectChannelRadio" GroupName="LaunchChannel" Margin="0,0,24,1" Checked="OnLaunchOptionChanged"
                                             Content="{Binding [Launch.Channel.Direct], Source={x:Static svc:Loc.Instance}}" />
                                <RadioButton x:Name="SteamChannelRadio" GroupName="LaunchChannel" Margin="0,0,24,1" Checked="OnLaunchOptionChanged"
                                             Content="{Binding [Launch.Channel.Steam], Source={x:Static svc:Loc.Instance}}" />
                                <RadioButton x:Name="RunOnceChannelRadio" GroupName="LaunchChannel" Margin="0,0,24,1" Checked="OnLaunchOptionChanged"
                                             Content="{Binding [Launch.Channel.RunOnce], Source={x:Static svc:Loc.Instance}}" />
                            </WrapPanel>
                            <TextBlock x:Name="ChannelNoteText" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" />
                            <TextBlock x:Name="ChannelBlockText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />

                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,36,0" MaxWidth="360">
                                    <TextBlock Style="{StaticResource GroupTitle}"
                                               Text="{Binding [Launch.Group.General], Source={x:Static svc:Loc.Instance}}" />
                                    <CheckBox x:Name="DisableUserSectionBox" Margin="0,1" Checked="OnLaunchOptionChanged" Unchecked="OnLaunchOptionChanged"
                                              Content="{Binding [Launch.Opt.DisableUserSection], Source={x:Static svc:Loc.Instance}}" />
                                    <CheckBox x:Name="DisableCodeModdingBox" Margin="0,1" Checked="OnLaunchOptionChanged" Unchecked="OnLaunchOptionChanged"
                                              Content="{Binding [Launch.Opt.DisableCodeModding], Source={x:Static svc:Loc.Instance}}" />
                                    <CheckBox x:Name="DisableModdingBox" Margin="0,1" Checked="OnLaunchOptionChanged" Unchecked="OnLaunchOptionChanged"
                                              Content="{Binding [Launch.Opt.DisableModding], Source={x:Static svc:Loc.Instance}}" />
                                    <CheckBox x:Name="NoSplashBox" Margin="0,1" Checked="OnLaunchOptionChanged" Unchecked="OnLaunchOptionChanged"
                                              Content="{Binding [Launch.Opt.NoSplash], Source={x:Static svc:Loc.Instance}}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Style="{StaticResource GroupTitle}"
                                               Text="{Binding [Launch.Group.Developer], Source={x:Static svc:Loc.Instance}}" />
                                    <CheckBox x:Name="DeveloperModeBox" Margin="0,1" Checked="OnLaunchOptionChanged" Unchecked="OnLaunchOptionChanged"
                                              Content="{Binding [Launch.Opt.DeveloperMode], Source={x:Static svc:Loc.Instance}}" />
                                    <CheckBox x:Name="UiDeveloperModeBox" Margin="0,1" Checked="OnLaunchOptionChanged" Unchecked="OnLaunchOptionChanged"
                                              Content="{Binding [Launch.Opt.UiDeveloperMode], Source={x:Static svc:Loc.Instance}}" />
                                    <CheckBox x:Name="DuplicateLogBox" Margin="0,1" Checked="OnLaunchOptionChanged" Unchecked="OnLaunchOptionChanged"
                                              Content="{Binding [Launch.Opt.DuplicateLogToDefault], Source={x:Static svc:Loc.Instance}}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,2">
                                        <TextBlock VerticalAlignment="Center" Margin="0,0,8,0"
                                                   Text="{Binding [Launch.Opt.LogLevel], Source={x:Static svc:Loc.Instance}}" />
                                        <ComboBox x:Name="LogLevelBox" MinWidth="170" DisplayMemberPath="Display"
                                                  SelectionChanged="OnLaunchOptionChanged" />
                                    </StackPanel>
                                    <CheckBox x:Name="DisableBurstBox" Margin="0,1" Checked="OnLaunchOptionChanged" Unchecked="OnLaunchOptionChanged"
                                              Content="{Binding [Launch.Opt.DisableBurst], Source={x:Static svc:Loc.Instance}}" />
                                    <TextBlock x:Name="BurstRunOnceText" Style="{StaticResource MutedText}" FontSize="12" Margin="28,0,0,0" Visibility="Collapsed"
                                               Text="{Binding [Launch.BurstRunOnce], Source={x:Static svc:Loc.Instance}}" />
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,8,0,0">
                                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Margin="0,0,8,0"
                                           Text="{Binding [Launch.Opt.Custom], Source={x:Static svc:Loc.Instance}}" />
                                <TextBox x:Name="CustomArgumentsBox" AcceptsReturn="False" TextChanged="OnCustomArgumentsChanged"
                                         LostKeyboardFocus="OnCustomArgumentsLostFocus"
                                         AutomationProperties.Name="{Binding [Launch.Opt.Custom], Source={x:Static svc:Loc.Instance}}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0"
                                       Text="{Binding [Launch.CustomNote], Source={x:Static svc:Loc.Instance}}" />
                            <TextBlock x:Name="CustomQuotesText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Text="{Binding [Launch.CustomQuotes], Source={x:Static svc:Loc.Instance}}" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- === MapExt 启动设定速选（MapExtPDX.coc）：三栏紧凑常驻，与"模组设置"全量页实时双向同步 === -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Top" Margin="16,0,0,0">
                            <Button x:Name="SaveButton" Style="{DynamicResource AccentButtonStyle}" MinWidth="84" Margin="0,0,6,0"
                                    Click="OnSaveClick" Content="{Binding [Startup.Save], Source={x:Static svc:Loc.Instance}}" />
                            <Button x:Name="ReloadButton" Style="{StaticResource ActionButton}" Click="OnReloadClick"
                                    Content="{Binding [Startup.Reload], Source={x:Static svc:Loc.Instance}}"
                                    ToolTip="{Binding [Startup.ReloadTip], Source={x:Static svc:Loc.Instance}}" />
                            <Button x:Name="DefaultsButton" Style="{StaticResource ActionButton}" Margin="0" Click="OnDefaultsClick"
                                    Content="{Binding [Startup.Defaults], Source={x:Static svc:Loc.Instance}}"
                                    ToolTip="{Binding [Startup.DefaultsTip], Source={x:Static svc:Loc.Instance}}" />
                        </WrapPanel>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}"
                                       Text="{Binding [Startup.Title], Source={x:Static svc:Loc.Instance}}" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="12"
                                       Text="{Binding [Startup.Intro], Source={x:Static svc:Loc.Instance}}" />
                        </StackPanel>
                    </DockPanel>

                    <DockPanel Margin="0,4,0,0">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,14,0">
                                <Hyperlink x:Name="OpenAllOptionsLink" Click="OnOpenAllOptionsClick">
                                    <Run x:Name="OpenAllOptionsRun" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0">
                                <Hyperlink x:Name="EditLink" Click="OnEditClick"
                                           ToolTip="{Binding [Startup.EditTip], Source={x:Static svc:Loc.Instance}}">
                                    <Run Text="{Binding [Startup.EditFile], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock FontSize="12" VerticalAlignment="Center">
                                <Hyperlink x:Name="ShowFileLink" Click="OnShowFileClick">
                                    <Run Text="{Binding [Startup.ShowInExplorer], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="FileText" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextTrimming="CharacterEllipsis" />
                    </DockPanel>

                    <!-- 三栏并排：左 地图尺寸模式 · 中 存档转换与安全校验 · 右 经济系统开关 -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" MinWidth="210" />
                            <ColumnDefinition Width="1.05*" MinWidth="220" />
                            <ColumnDefinition Width="1.25*" MinWidth="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                            <TextBlock Style="{StaticResource GroupTitle}"
                                       Text="{Binding [Startup.Group.Mode], Source={x:Static svc:Loc.Instance}}" />
                            <StackPanel x:Name="ModePanel" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,18,0">
                            <TextBlock Style="{StaticResource GroupTitle}"
                                       Text="{Binding [Startup.Group.ConvertAndCheck], Source={x:Static svc:Loc.Instance}}" />
                            <StackPanel x:Name="OtherPanel" />
                            <TextBlock Style="{StaticResource MutedText}" FontSize="11" Margin="28,2,0,0"
                                       Text="{Binding [Startup.MutualExclusion], Source={x:Static svc:Loc.Instance}}" />
                            <TextBlock x:Name="ValidationWarning" TextWrapping="Wrap" FontSize="11" Margin="28,2,0,0" Visibility="Collapsed"
                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                       Text="{Binding [Startup.ValidationOff], Source={x:Static svc:Loc.Instance}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Style="{StaticResource GroupTitle}"
                                       Text="{Binding [Startup.Group.Economy], Source={x:Static svc:Loc.Instance}}" />
                            <StackPanel x:Name="EconomyPanel" />
                            <TextBlock x:Name="EconomyOffText" Style="{StaticResource MutedText}" FontSize="12" Margin="28,2,0,0" Visibility="Collapsed"
                                       Text="{Binding [Startup.EconomyOff], Source={x:Static svc:Loc.Instance}}" />
                        </StackPanel>
                    </Grid>

                    <!-- 状态：游戏是否在运行、文件问题、刚才的操作；待保存的改动；最近一次启动实际生效的配置 -->
                    <ItemsControl x:Name="StatusLines" Margin="0,7,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type views:ToneLine}">
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,1" Style="{StaticResource ToneText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="PendingText" Margin="0,1,0,0" FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Text}"
                               Style="{StaticResource ToneText}" />
                    <TextBlock x:Name="AppliedText" Margin="0,2,0,0" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                </StackPanel>
            </Border>

            <!-- === MapExTools 的位置与桌面快捷方式：低频操作默认收起，标题显示当前摘要 === -->
            <Expander x:Name="InstallExpander" Margin="0,0,0,4"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                      AutomationProperties.Name="{Binding [Install.Title], Source={x:Static svc:Loc.Instance}}">
                <Expander.Header>
                    <WrapPanel>
                        <TextBlock FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center"
                                   Text="{Binding [Install.Title], Source={x:Static svc:Loc.Instance}}" />
                        <TextBlock x:Name="InstallSummaryText" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding Text}" Style="{StaticResource ToneText}" />
                    </WrapPanel>
                </Expander.Header>
                <StackPanel Margin="0,2,0,0">
                    <TextBlock x:Name="LocationText" TextWrapping="Wrap" FontSize="12" />
                    <TextBlock x:Name="ShortcutText" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0" />
                    <WrapPanel Margin="0,8,0,0">
                        <Button x:Name="PinButton" Style="{DynamicResource AccentButtonStyle}" Margin="0,0,8,4" Click="OnPinClick"
                                Content="{Binding [Install.Pin], Source={x:Static svc:Loc.Instance}}" />
                        <Button x:Name="CreateShortcutButton" Style="{StaticResource ActionButton}" Click="OnCreateShortcutClick" />
                        <Button x:Name="DeleteShortcutButton" Style="{StaticResource ActionButton}" Click="OnDeleteShortcutClick"
                                Content="{Binding [Install.DeleteShortcut], Source={x:Static svc:Loc.Instance}}" />
                    </WrapPanel>
                    <TextBlock x:Name="InstallNote" Style="{StaticResource MutedText}" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
