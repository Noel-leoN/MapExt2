<UserControl x:Class="MapExTools.Views.ModSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:MapExTools.Services">
    <UserControl.Resources>
        <Style x:Key="ToolbarCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="MinWidth" Value="82" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="8,0,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <!-- 模组设置中心：上常驻搜索与保存状态条，下左分类导航 + 右分组卡片／3×3 租金矩阵 -->
    <Grid Margin="10,6,10,4">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- === 顶部常驻工具与状态栏 === -->
        <Border Grid.Row="0" Style="{StaticResource ToolbarCard}">
            <DockPanel LastChildFill="True">
                <!-- 右侧：保存／重读／全部默认 -->
                <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Button x:Name="SaveButton" Style="{DynamicResource AccentButtonStyle}" MinWidth="84" Margin="0,0,6,0"
                            Click="OnSaveClick" Content="{Binding [Startup.Save], Source={x:Static svc:Loc.Instance}}" />
                    <Button x:Name="ReloadButton" Style="{StaticResource ActionButton}" Click="OnReloadClick"
                            Content="{Binding [Startup.Reload], Source={x:Static svc:Loc.Instance}}"
                            ToolTip="{Binding [Startup.ReloadTip], Source={x:Static svc:Loc.Instance}}" />
                    <Button x:Name="ResetAllButton" Style="{StaticResource ActionButton}" Margin="0" Click="OnResetAllClick"
                            Content="{Binding [Options.ResetAll], Source={x:Static svc:Loc.Instance}}"
                            ToolTip="{Binding [Options.ResetAllTip], Source={x:Static svc:Loc.Instance}}" />
                </WrapPanel>

                <!-- 左侧：实时搜索过滤框 -->
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <Grid Width="236">
                        <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="8,4" MinHeight="30"
                                 TextChanged="OnSearchTextChanged"
                                 AutomationProperties.Name="{Binding [Options.SearchPlaceholder], Source={x:Static svc:Loc.Instance}}" />
                        <TextBlock x:Name="SearchPlaceholder" Margin="10,0,8,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="12"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding [Options.SearchPlaceholder], Source={x:Static svc:Loc.Instance}}" />
                    </Grid>
                    <Button x:Name="ClearSearchButton" Visibility="Collapsed" Margin="6,0,0,0" Padding="8,4" MinHeight="30"
                            Click="OnClearSearchClick"
                            Content="{Binding [Options.ClearSearch], Source={x:Static svc:Loc.Instance}}" />
                </StackPanel>

                <!-- 中间：设定文件状态、待保存改动与文件链接 -->
                <StackPanel VerticalAlignment="Center">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0">
                                <Hyperlink x:Name="EditLink" Click="OnEditClick"
                                           ToolTip="{Binding [Startup.EditTip], Source={x:Static svc:Loc.Instance}}">
                                    <Run Text="{Binding [Startup.EditFile], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                            <TextBlock FontSize="12" VerticalAlignment="Center">
                                <Hyperlink x:Name="ShowFileLink" Click="OnShowFileClick">
                                    <Run Text="{Binding [Startup.ShowInExplorer], Source={x:Static svc:Loc.Instance}, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <TextBlock x:Name="PrimaryStatusText" FontSize="12" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Text}" Style="{StaticResource ToneText}" />
                    </DockPanel>
                    <TextBlock x:Name="PendingStatusText" FontSize="12" Margin="0,1,0,0"
                               TextTrimming="CharacterEllipsis" Text="{Binding Text}" Style="{StaticResource ToneText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- === 主体：左分类导航 + 右分组卡片区 === -->
        <Grid Grid.Row="1" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="206" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧 6 大分类导航 -->
            <ListBox x:Name="CategoryList" Grid.Column="0" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnCategorySelectionChanged">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,7" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <!-- 右侧分组卡片容器 -->
            <Grid Grid.Column="1" Margin="12,0,0,0">
                <TextBlock x:Name="NoMatchText" Visibility="Collapsed" Margin="12,16,0,0" FontSize="13"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <ScrollViewer x:Name="CardsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="CardsHost" Margin="0,0,4,6" />
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
