<Window x:Class="MapExTools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="clr-namespace:MapExTools.Services"
        xmlns:views="clr-namespace:MapExTools.Views"
        Title="{Binding [App.Title], Source={x:Static svc:Loc.Instance}}"
        Icon="Assets/MapExTools.ico"
        Width="1100" Height="720" MinWidth="920" MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 横幅：在临时目录或下载文件夹里运行时提供"固定到本地"（计划 §2 第 9 条），只在玩家点击后执行 -->
        <Border x:Name="PinBanner" Grid.Row="0" Visibility="Collapsed" Margin="16,10,16,0" Padding="12,8"
                CornerRadius="4" BorderThickness="1"
                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button x:Name="BannerHideButton" DockPanel.Dock="Right" Content="×" Padding="10,2" Margin="8,0,0,0"
                        VerticalAlignment="Center" Click="OnHideBannerClick"
                        ToolTip="{Binding [Install.Banner.Hide], Source={x:Static svc:Loc.Instance}}"
                        AutomationProperties.Name="{Binding [Install.Banner.Hide], Source={x:Static svc:Loc.Instance}}" />
                <Button x:Name="BannerPinButton" DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center"
                        Style="{DynamicResource AccentButtonStyle}" Click="OnPinClick"
                        Content="{Binding [Install.Pin], Source={x:Static svc:Loc.Instance}}" />
                <TextBlock x:Name="BannerText" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 六个功能页 -->
        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="12,8,12,6">
            <TabItem Header="{Binding [Tab.Launch], Source={x:Static svc:Loc.Instance}}">
                <views:LaunchSettingsPage x:Name="LaunchPage" />
            </TabItem>
            <TabItem x:Name="OptionsTab">
                <views:ModSettingsPage x:Name="OptionsPage" />
            </TabItem>
            <TabItem x:Name="ConflictsTab">
                <views:ConflictCheckPage x:Name="ConflictsPage" />
            </TabItem>
            <TabItem Header="{Binding [Tab.Logs], Source={x:Static svc:Loc.Instance}}">
                <views:LogViewerPage />
            </TabItem>
            <TabItem Header="{Binding [Tab.Saves], Source={x:Static svc:Loc.Instance}}">
                <views:SavesMapsPage />
            </TabItem>
            <TabItem Header="{Binding [Tab.Heightmaps], Source={x:Static svc:Loc.Instance}}">
                <views:HeightmapViewerPage />
            </TabItem>
        </TabControl>

        <!-- 顶部右侧（与页签栏同行，节省一行垂直空间）：界面语言与主题 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,16,0">
            <TextBlock Text="{Binding [Settings.Language], Source={x:Static svc:Loc.Instance}}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="LanguageBox" MinWidth="118" DisplayMemberPath="Display"
                      SelectionChanged="OnLanguageChanged" />
            <TextBlock Text="{Binding [Settings.Theme], Source={x:Static svc:Loc.Instance}}"
                       VerticalAlignment="Center" Margin="14,0,6,0" />
            <ComboBox x:Name="ThemeBox" MinWidth="112" DisplayMemberPath="Display"
                      SelectionChanged="OnThemeChanged" />
        </StackPanel>

        <!-- 底部常驻：游戏运行状态与用户数据目录 -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" Padding="16,6"
                BorderBrush="{DynamicResource {x:Static SystemColors.ActiveBorderBrushKey}}">
            <DockPanel>
                <Ellipse x:Name="GameStateDot" Width="10" Height="10" Margin="0,0,8,0" VerticalAlignment="Center" />
                <TextBlock x:Name="GameStateText" VerticalAlignment="Center" />
                <TextBlock x:Name="UserDataText" VerticalAlignment="Center" HorizontalAlignment="Right"
                           Opacity="0.7" TextTrimming="CharacterEllipsis" Margin="24,0,0,0" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
