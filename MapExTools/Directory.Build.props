<Project>
  <!-- MapExTools 三个工程的共同属性。只作用于 MapExTools/ 之下，不影响 MapExtPDX 等 Mod 工程 -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.1.0</Version>
    <Authors>Noel2</Authors>
    <Product>MapExTools</Product>
    <Copyright>Copyright (c) 2026 Noel2 (Noel-leoN)</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- 从 GitHub 源码压缩包（无 .git）执行 CI 确定性构建时提供仓库根 SourceRoot 兜底，避免产出空 PathMap -->
  <PropertyGroup>
    <_MapExToolsRepoRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)..'))</_MapExToolsRepoRoot>
  </PropertyGroup>
  <ItemGroup Condition="'$(ContinuousIntegrationBuild)' == 'true' and !Exists('$(_MapExToolsRepoRoot).git')">
    <SourceRoot Include="$(_MapExToolsRepoRoot)" />
  </ItemGroup>
</Project>
